+    stripMarkdownLinks(replaceRanges(stripInternalReaderOutcomeComments(prose), htmlTagRanges(prose), " ")),
+    isLineBoundary(withoutHtmlBlocks, cursor)
+  );
+  return output
+    .replaceAll(WHITESPACE, " ")
+    .trim();
+};
