{
  "name": "@blackops/docs-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.12.0"
  },
  "scripts": {
    "content:generate": "node scripts/generate-content.mjs",
    "content:check": "node scripts/check-content.mjs",
    "diagrams:check": "node scripts/check-diagrams.mjs",
    "site:check": "node scripts/check-site.mjs",
    "blume:validate": "node scripts/validate-content.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "blume:check": "blume check",
    "check": "pnpm run content:check && pnpm run diagrams:check && pnpm run blume:validate && pnpm run blume:check",
    "build": "pnpm run content:generate && pnpm run diagrams:check && pnpm run blume:validate && blume build && node scripts/check-artifact.mjs && pnpm run site:check",
    "dev": "pnpm run content:generate && blume dev --host 0.0.0.0"
  },
  "dependencies": {
    "blume": "1.1.4"
  },
  "devDependencies": {
    "astro": "7.0.7",
    "jsdom": "29.1.1",
    "mermaid": "11.16.0",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "wrangler": "4.110.0"
  }
}
