---
import PageLayout from 'blume/components/layout/PageLayout.astro';
import data from 'blume:data';
import ExecutionWalkthrough from '../components/ExecutionWalkthrough.astro';
import LandingBackdrop from '../components/LandingBackdrop.astro';
import LandingMotion from '../components/LandingMotion.astro';
import type { ExecutionWalkthroughRegion, ExecutionWalkthroughLink } from '../components/ExecutionWalkthrough.astro';
import SearchFocusBoundary from '../components/SearchFocusBoundary.astro';
import executionDiagram from '../public/diagrams/execution-overview.json';
import executionDesktopDiagram from '../public/diagrams/execution-overview-desktop.json';
import '../design-tokens.css';
import '../documentation.css';
import '../theme.css';

const { config } = data;

const executionLinks: ExecutionWalkthroughLink[] = [
  { id: 'http-entry', label: 'HTTP', href: '/execution/http-and-deferred#inline-http', description: 'RequestをOperationへ渡す入口', detail: 'RequestをOperationへ渡します。Inlineは完了後に応答し、Deferredは受付後にHTTP 202とOperation IDを返します。' },
  { id: 'value-binding', label: 'Value', href: '/operations/validation', description: '入力を型付けし検証する境界', detail: '入力をOperationValueへ変換し、Validationを実行します。Operationには型付きの値を渡します。' },
  { id: 'strategy', label: 'Strategy', href: '/execution/http-and-deferred', description: 'InlineまたはDeferredを選ぶ経路', detail: 'OperationのMetadataに従い、HTTP内で実行するInlineか、Workerへ引き継ぐDeferredかを選びます。' },
  { id: 'durable-transport', label: 'Durable Transport', href: '/execution/http-and-deferred#deferred-http', description: 'Deferredの受付を永続化する境界', detail: 'DeferredのValueとContextを保持し、Workerが取得できる状態にします。受付Journalも同じTransactionで確定します。' },
  { id: 'worker', label: 'Worker', href: '/execution/http-and-deferred#worker', description: '受理済みのOperationを引き継ぐ実行者', detail: '受理済みのValueとContextを取得し、別プロセスでAttemptを開始してOperationを実行します。' },
  { id: 'operation', label: 'Operation', href: '/operations/authoring', description: 'Applicationの意図を実行する単位', detail: 'handle()にアプリケーションの処理を実装します。InlineでもDeferredでも、Valueと必要なContextを受け取りOutcomeを返します。' },
  { id: 'outcome', label: 'Outcome', href: '/database/outcomes', description: '正常完了で返す型付きOutput', detail: '正常完了した処理の型付きの結果です。InlineではResponseに変換し、Deferredでは完了Journalと同じTransactionで保存します。' },
];

const executionGeometry = {
  width: executionDiagram.meta.viewBox[0],
  height: executionDiagram.meta.viewBox[1],
};

const executionDesktopGeometry = {
  width: executionDesktopDiagram.meta.viewBox[0],
  height: executionDesktopDiagram.meta.viewBox[1],
};

const executionRegions: ExecutionWalkthroughRegion[] = executionLinks.map((link) => {
  const component = executionDiagram.components.find(({ id }) => id === link.id);
  if (!component) throw new Error(`Execution overview diagram is missing component ${link.id}.`);
  return {
    id: link.id,
    x: component.pos[0],
    y: component.pos[1],
    width: component.size[0],
    height: component.size[1],
  };
});
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  navigation={data.navigation}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  locale="ja"
  ui={data.ui}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{ title: 'BlackOps - The PHP Framework', description: config.description, route: '/' }}
>
  <SearchFocusBoundary />
  <LandingMotion />
  <div class="landing-shell">
    <LandingBackdrop />
    <header class="landing-hero" aria-labelledby="landing-title" data-landing-reveal="hero">
      <div class="landing-hero__identity" data-landing-reveal="identity">
        <h1 id="landing-title"><span class="landing-brand" data-landing-neon-title>BlackOps</span> <span class="landing-tagline">The PHP Framework</span></h1>
        <p class="landing-value">HTTPとWorkerの処理を一つのOperationとして扱い、受付・再試行・完了までを同じIDで追跡できるPHP Frameworkです。</p>
        <p class="landing-value-note">入口がHTTPでもConsoleでもScheduleでも、ValueとContextをOperationへ渡し、InlineまたはDeferredの実行経路を選べます。</p>
      </div>

      <div class="landing-hero__actions" data-landing-reveal="actions">
        <div class="landing-actions" aria-label="ドキュメントの操作">
          <a class="landing-button landing-button-primary" data-landing-action="why" href="/concepts/why-blackops">What's BlackOps</a>
          <a class="landing-button landing-button-secondary" data-landing-action="install" href="/getting-started/installation">Install</a>
        </div>
        <div class="landing-install">
          <p class="landing-install-label">Stable 1.2.0</p>
          <pre class="landing-command blackops-overflow-focus" tabindex="0"><code>composer create-project blackops/skeleton my-app 1.2.0</code></pre>
        </div>
        <a class="landing-cli-entry" href="/reference/project-cli"><strong>BlackOps CLI</strong><span>Command、Runtime、Output、Exitを調べる</span><span aria-hidden="true">→</span></a>
      </div>

      <div class="landing-hero__code" data-landing-reveal="code">
        <div class="landing-code-panel" aria-label="Operationのソース">
          <div class="landing-code-header"><span>GenerateReport.php</span><span>PHP</span></div>
          <pre class="blackops-overflow-focus" tabindex="0"><code><span class="syntax-keyword">#[Route(method: </span><span class="syntax-string">'POST'</span><span class="syntax-keyword">, path: </span><span class="syntax-string">'/reports'</span><span class="syntax-keyword">)]</span>
<span class="syntax-keyword">#[OperationType('report.generate')]</span>
<span class="syntax-keyword">#[Deferred]</span>
<span class="syntax-keyword">final readonly class</span> GenerateReport <span class="syntax-keyword">implements</span> Operation
&#123;
    <span class="syntax-keyword">public function</span> handle(
        GenerateReportValue $value,
        ExecutionContext $context,
    ): ReportGenerated
    &#123;
        return new ReportGenerated(
            $value->reportName,
            '/reports/generated/' . $value->reportName . '.json',
        );
    &#125;
&#125;</code></pre>
        </div>
      </div>

      <nav class="landing-entry-points" aria-label="Operationの入口" data-landing-reveal="entry-points">
        <a href="/execution/http-and-deferred#inline-http"><span>HTTP</span><small>Request</small></a>
        <a href="/execution/console-command"><span>Console</span><small>Operation CLI</small></a>
        <a href="/operations/scheduled-operation"><span>Schedule</span><small>定期実行</small></a>
      </nav>
    </header>

    <div class="landing-demo" data-landing-reveal="demo">
      <ExecutionWalkthrough
        svgSrc="/diagrams/execution-overview.svg"
        dataSrc="/diagrams/execution-overview.json"
        desktopSvgSrc="/diagrams/execution-overview-desktop.svg"
        desktopDataSrc="/diagrams/execution-overview-desktop.json"
        svgAlt="HTTPの入力をValueへ変換し、InlineまたはDeferredでOperationを実行してOutcomeへ進む処理経路の図。"
        geometry={executionGeometry}
        desktopGeometry={executionDesktopGeometry}
        links={executionLinks}
        regions={executionRegions}
      />
    </div>

    <section class="landing-resources" aria-labelledby="landing-resources-title" data-landing-reveal="resources">
      <div class="landing-resource-layout">
        <div class="landing-section-heading">
          <h2 id="landing-resources-title">BlackOpsを動かす</h2>
          <p>環境を用意し、サンプルで動きを確かめてから、自分のOperationを作ります。</p>
        </div>
        <div class="landing-resource-group">
          <ol class="landing-journey">
            <li>
              <a href="/getting-started/installation">
                <span class="landing-journey-index">01</span>
                <span class="landing-journey-copy"><strong>環境を用意する</strong><small>PHPとComposerでProjectを作り、Local環境を準備する</small></span>
                <span class="landing-journey-action" aria-hidden="true">→</span>
              </a>
            </li>
            <li>
              <a href="/getting-started/quickstart">
                <span class="landing-journey-index">02</span>
                <span class="landing-journey-copy"><strong>サンプルを動かす</strong><small>認証付きHTTPとDeferred Workerを順に確認する</small></span>
                <span class="landing-journey-action" aria-hidden="true">→</span>
              </a>
            </li>
            <li>
              <a href="/getting-started/first-operation">
                <span class="landing-journey-index">03</span>
                <span class="landing-journey-copy"><strong>Operationを作る</strong><small>CLIで生成し、HTTPとWorkerで完走する</small></span>
                <span class="landing-journey-action" aria-hidden="true">→</span>
              </a>
            </li>
          </ol>
        </div>
      </div>
    </section>
  </div>
</PageLayout>
