---
import PageLayout from 'blume/components/layout/PageLayout.astro';
import data from 'blume:data';
import SearchFocusBoundary from '../components/SearchFocusBoundary.astro';
import '../theme.css';

const { config } = data;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  navigation={data.navigation}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  locale="ja"
  ui={data.ui}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{ title: 'BlackOps - The PHP Framework', description: config.description, route: '/' }}
>
  <SearchFocusBoundary />
  <div class="landing-shell">
    <section class="landing-hero" aria-labelledby="landing-title">
      <div class="landing-hero-content">
        <p class="landing-eyebrow">PHP 8.5向けFramework</p>
        <h1 id="landing-title"><span class="landing-brand">BlackOps</span> <span class="landing-tagline">The PHP Framework</span></h1>
        <p class="landing-value">HTTPとWorkerの処理を一つのOperationとして扱い、受付・再試行・完了までを同じIDで追跡できるPHP Frameworkです。</p>
        <p class="landing-value-note">この処理単位をOperationと呼び、Inline／Deferred Workerで同じLifecycleを追跡します。</p>
        <div class="landing-actions" aria-label="ドキュメントの操作">
          <a class="landing-button landing-button-primary" href="/getting-started/installation">Install</a>
          <a class="landing-button landing-button-secondary" href="/getting-started/quickstart">Quickstart and Skeleton</a>
        </div>
        <div class="landing-install">
          <p class="landing-install-label">Stable 1.2.0 install</p>
          <pre class="landing-command blackops-overflow-focus" tabindex="0"><code>composer create-project blackops/skeleton my-app 1.2.0</code></pre>
        </div>
        <a class="landing-cli-entry" href="/reference/project-cli"><strong>BlackOps CLI</strong><span>Command、Runtime、Output、Exitを調べる</span></a>
      </div>

      <div class="landing-product-visual" aria-labelledby="landing-operation-visual-title">
        <div class="landing-code-panel">
          <div class="landing-editor-chrome" aria-label="Operationのソース">
            <span class="landing-editor-tab" aria-current="true">GenerateReport.php</span>
            <span class="landing-editor-language">PHP</span>
          </div>
          <div class="landing-panel-bar"><span class="landing-panel-kicker" id="landing-operation-visual-title">Operation</span><span class="landing-panel-file">Deferred Operation</span></div>
          <pre class="blackops-overflow-focus" tabindex="0"><code><span class="syntax-keyword">#[Route(method: </span><span class="syntax-string">'POST'</span><span class="syntax-keyword">, path: </span><span class="syntax-string">'/reports'</span><span class="syntax-keyword">)]</span>
<span class="syntax-keyword">#[OperationType('report.generate')]</span>
<span class="syntax-keyword">#[Deferred]</span>
<span class="syntax-keyword">final readonly class</span> GenerateReport <span class="syntax-keyword">implements</span> Operation
&#123;
    <span class="syntax-keyword">public function</span> handle(
        GenerateReportValue $value,
        ExecutionContext $context,
    ): ReportGenerated
    &#123;
        return new ReportGenerated(
            $value->reportName,
            '/reports/generated/' . $value->reportName . '.json',
        );
    &#125;
&#125;</code></pre>
        </div>
        <section class="landing-lifecycle-panel" aria-labelledby="landing-lifecycle-title">
          <div class="landing-lifecycle-heading">
            <h2 id="landing-lifecycle-title">Operation Lifecycle</h2>
            <span>同じID</span>
          </div>
          <p class="landing-lifecycle-caption">同じOperation IDで、受付、Attempt、完了までの実行事実を追跡します。</p>
          <p class="landing-lifecycle-note">Retryは同じIDの次のAttemptとして続きます。</p>
          <ol class="landing-lifecycle-rail">
            <li><span class="landing-lifecycle-marker" aria-hidden="true"></span><span><strong>Received</strong><small>受付された</small></span></li>
            <li><span class="landing-lifecycle-marker" aria-hidden="true"></span><span><strong>Accepted</strong><small>Deferredを引き受けた</small></span></li>
            <li><span class="landing-lifecycle-marker" aria-hidden="true"></span><span><strong>Running</strong><small>Attemptを開始した</small></span></li>
            <li><span class="landing-lifecycle-marker" aria-hidden="true"></span><span><strong>Finalizing</strong><small>attempt.succeeded — Handlerが成功した</small></span></li>
            <li><span class="landing-lifecycle-marker" aria-hidden="true"></span><span><strong>Completed</strong><small>処理を完了した</small></span></li>
          </ol>
        </section>
        <p class="landing-visual-caption">実際のOperation codeで、RouteとDeferredの境界を確認できます。</p>
        <a class="landing-visual-link" href="/concepts/lifecycle">LifecycleのEventを読む</a>
      </div>
    </section>

    <section class="landing-start" aria-labelledby="landing-start-title">
      <div class="landing-section-heading">
        <h2 id="landing-start-title">最初のOperationまで</h2>
        <p>Installから実行結果の確認まで、順番に進めます。</p>
      </div>
      <ol class="landing-journey">
        <li>
          <a href="/getting-started/installation">
            <span class="landing-journey-copy"><strong>Install</strong><small>ProjectとLocal環境を準備する</small></span>
            <span class="landing-journey-action">開く</span>
          </a>
        </li>
        <li>
          <a href="/getting-started/quickstart">
            <span class="landing-journey-copy"><strong>Quickstart and Skeleton</strong><small>InlineとDeferredを動かす</small></span>
            <span class="landing-journey-action">開く</span>
          </a>
        </li>
        <li>
          <a href="/getting-started/first-operation">
            <span class="landing-journey-copy"><strong>First Operation</strong><small>自分のOperationを生成して完走する</small></span>
            <span class="landing-journey-action">開く</span>
          </a>
        </li>
      </ol>
    </section>

    <section class="landing-model" aria-labelledby="landing-model-title">
      <div class="landing-section-heading">
        <h2 id="landing-model-title">一つのOperationを追いかける</h2>
        <p>入口が変わっても、受理されたOperationの実行事実を同じ形で確認します。</p>
      </div>
      <dl class="landing-model-list">
        <div>
          <dt>Operation</dt>
          <dd>Valueを受け取り、Outcomeを返すApplicationの仕事を一つの契約にします。</dd>
        </div>
        <div>
          <dt>Inline and Deferred</dt>
          <dd>HTTPではその場で実行し、Deferredでは受理後にWorkerが続きから実行します。</dd>
        </div>
        <div>
          <dt>Lifecycle and Journal</dt>
          <dd>Received、Accepted、Running、Completedなどの実行事実をJournalで追跡します。</dd>
        </div>
      </dl>
      <div class="landing-model-links">
        <a class="landing-text-link" href="/concepts/why-blackops">What's BlackOpsを読む</a>
        <a class="landing-text-link" href="/concepts/journal">Journalを読む</a>
      </div>
    </section>

    <section class="landing-purpose" aria-labelledby="landing-purpose-title">
      <div class="landing-section-heading">
        <h2 id="landing-purpose-title">目的から探す</h2>
      </div>
      <nav class="landing-purpose-nav" aria-label="ドキュメントのセクション">
        <a href="/operations/authoring"><span><strong>Build</strong><small>Operation、Validation、Frontendを組み立てる</small></span><span aria-hidden="true">開く</span></a>
        <a href="/concepts/lifecycle"><span><strong>Async and Lifecycle</strong><small>Deferred、Outcome、Journalを追跡する</small></span><span aria-hidden="true">開く</span></a>
        <a href="/database/transactions"><span><strong>Data and Security</strong><small>Transaction、Migration、Tenantを守る</small></span><span aria-hidden="true">開く</span></a>
        <a href="/reference/configuration"><span><strong>Operate</strong><small>Configuration、Deployment、Observabilityを確認する</small></span><span aria-hidden="true">開く</span></a>
        <a href="/reference/project-cli"><span><strong>Reference</strong><small>CLI、Bootstrap、APIの契約を調べる</small></span><span aria-hidden="true">開く</span></a>
        <a href="/releases/current-status"><span><strong>Releases</strong><small>Stable 1.2.0の提供範囲と移行情報を確認する</small></span><span aria-hidden="true">開く</span></a>
      </nav>
    </section>
  </div>
</PageLayout>
