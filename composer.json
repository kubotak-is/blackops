{
    "name": "blackops/framework",
    "description": "BlackOps PHP Framework.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-sodium": "*",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/log": "^3.0",
        "psr/clock": "^1.0",
        "vlucas/phpdotenv": "^5.6",
        "nyholm/psr7": "^1.8",
        "nikic/fast-route": "^1.3",
        "symfony/uid": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/config": "^7.4",
        "symfony/validator": "^7.4",
        "monolog/monolog": "^3.10",
        "doctrine/dbal": "^4.4",
        "doctrine/migrations": "^3.9",
        "symfony/stopwatch": "^7.4",
        "open-telemetry/api": "^1.10"
    },
    "require-dev": {
        "carthage-software/mago": "1.42.0",
        "open-telemetry/sdk": "^1.15",
        "open-telemetry/exporter-otlp": "^1.4",
        "php-http/guzzle7-adapter": "^1.1",
        "phpunit/phpunit": "13.2.2",
        "deptrac/deptrac": "4.7.1"
    },
    "autoload": {
        "psr-4": {
            "BlackOps\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlackOps\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/.gitattributes",
            "/.agents",
            "/.codex",
            "/.claude",
            "/.github",
            "/develop",
            "/docs",
            "/examples",
            "/tests",
            "/.deptrac.cache",
            "/.dockerignore",
            "/.env",
            "/.env.example",
            "/.gitignore",
            "/.phpunit.cache",
            "/AGENTS.md",
            "/Dockerfile",
            "/Dockerfile.frankenphp",
            "/compose.yaml",
            "/composer.lock",
            "/deptrac.yaml",
            "/mago.toml",
            "/mago-lint-baseline.toml",
            "/mise.toml",
            "/phpunit.xml",
            "/runtime",
            "/vendor"
        ]
    },
    "config": {
        "allow-plugins": {
            "carthage-software/mago-composer-plugin": true
        }
    }
}
